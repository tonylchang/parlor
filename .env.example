# Ollama backend for the LLM (default: http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen3-vl:8b

# faster-whisper STT (default model: medium, language: auto-detect)
# WHISPER_MODEL=medium
# WHISPER_LANGUAGE=en

# Server port (default: 8000)
# PORT=8000

# --- Caddy reverse-proxy deployment (deploy/Caddyfile) ---
# bcrypt hash for basic auth; generate with `caddy hash-password`
# CADDY_BASIC_AUTH_HASH=
